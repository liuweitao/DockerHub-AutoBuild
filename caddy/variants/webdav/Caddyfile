{
    # Global options
    admin off
    persist_config off
}

:80 {
  respond "Hello, world!"
}

example.com {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
  respond "Hello from example.com!"
}

# WebDAV configuration
# Replace 'yourdomain.com' with your actual domain or remove if not using a specific domain for WebDAV
yourdomain.com/webdav/* {
  # Optional: Basic authentication
  # basic_auth {
  #   username $2a$14$example-hash # replace with the output of: caddy hash-password
  # }

  webdav {
    root /srv/webdav
    prefix /webdav
  }
}

